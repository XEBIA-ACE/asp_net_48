# Copy to .env.local and adjust. All runtime config comes from VITE_* variables.
# Base URL of the backend API (no default is hardcoded; leave empty to show the "not configured" notice).
VITE_API_BASE_URL=
# Application title shown in the header (optional; defaults to "API Documentation").
VITE_APP_TITLE=
# Feature flags: "true" enables, anything else disables.
VITE_FEATURE_API_EXPLORER=true
VITE_FEATURE_SEARCH=false
